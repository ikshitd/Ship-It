generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String
  boards    Board[] @relation("UserBoards")
  comments  Comment[]
  projectCanvases ProjectCanvas[] @relation("UserCanvas")
}

model Board {
  id        Int     @id @default(autoincrement())
  name      String
  userId    Int     
  users      User[]   @relation("UserBoards")
  tasks     Task[]  
}

model Task {
  id            Int       @id @default(autoincrement())
  heading       String
  description   String?
  startDate     DateTime
  dueDate       DateTime
  priority      Priority
  status        Status
  taskCategory  TaskCategory
  assignee    String
  aiGeneratedResponse String?
  boardId       Int   
  board         Board     @relation(fields: [boardId], references: [id])
  comments      Comment[]
  nodeId Int?
  node   Node? @relation(fields: [nodeId], references: [id])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  userId    Int
  taskId    Int
  user      User     @relation(fields: [userId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])
}

model ProjectCanvas {
  id        Int   @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nodes     Node[]
  edges     Edge[]
  users     User[]   @relation("UserCanvas")
}

model Node {
  id          Int   @id @default(autoincrement())
  heading     String
  description String?
  priority    String
  x   Float
  y   Float
  type        String
  projectCanvasId Int
  projectCanvas   ProjectCanvas @relation(fields: [projectCanvasId], references: [id])
  tasks Task[]
}

model Edge {
  id         Int   @id @default(autoincrement())
  source     String
  target     String
  animated   Boolean  @default(false)
  label      String?
  type       String
  projectCanvasId Int
  projectCanvas   ProjectCanvas @relation(fields: [projectCanvasId], references: [id])
}

enum Status {
  On_Track
  Off_Risk
  At_Risk
}

enum TaskCategory {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  Low
  Medium
  High
}